# Copy this file to .env and adjust values for your machine.

NODE_ENV=development
FRONTEND_PORT=5173

# Optional AI providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI_MAPPING=false

# SpacetimeDB/Rust runtime.
ENABLE_SPACETIME=false
SPACETIMEDB_URL=http://localhost:3001
SPACETIMEDB_MODULE=verrow
SPACETIME_PORT=3001
SPACETIME_DB=verrow
RUST_INGEST_API_PORT=3010
RUST_INGEST_API_URL=http://localhost:3010
INGEST_API_BIND_ADDR=0.0.0.0:3010
INGEST_API_MAX_UPLOAD_BYTES=10485760
INGEST_API_CSV_SAMPLE_ROWS=25
VITE_ENABLE_SPACETIME=false
VITE_SPACETIME_HOST=ws://localhost:3001
VITE_SPACETIME_DB=verrow
VITE_SPACETIME_MODULE=verrow
VITE_RUST_INGEST_API_URL=http://localhost:3010

# Optional custom REST gateway for experiments outside the default stack.
VITE_ENABLE_REST_GATEWAY=false
VITE_REST_GATEWAY_URL=
